{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=3000",
    "MarketDb": "Server=localhost\\SQLEXPRESS;Database=JarvisMarket;Integrated Security=true;TrustServerCertificate=true;Encrypt=false"
  },
  "Delta": {
    "Symbol": "BTCUSD",
    "RedisTradeStreamMaxLength": 100000,
    "TickerSnapshotSeconds": 60
  },
  "Redis": {
    "AutoStartWsl": true,
    "WslDistro": "Ubuntu"
  },
  "Realtime": {
    "StreamMaxLength": 50000,
    "RetentionDays": 7,
    "SimPnlSeconds": 10
  },
  "Fyers": {
    "Poll": {
      "Enabled": true,
      "Seconds": 10,
      "QuoteSymbols": "NSE:NIFTY50-INDEX,NSE:NIFTYBANK-INDEX,BSE:SENSEX-INDEX"
    }
  },
  "Simulation": {
    "Enabled": true,
    "TickMs": 2000,
    "Scenario": "Normal"
  }
}
